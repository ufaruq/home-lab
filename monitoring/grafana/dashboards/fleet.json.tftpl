{
  "uid": "homelab-fleet",
  "title": "Home lab fleet",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "homelab",
    "terraform"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Collector scrape health",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(host,environment,role) (up{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\"})",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "description": "1 means last scrape succeeded. An absent host disappears here; per-host expected-host alerts detect that absence.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Linux CPU used",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(host) (rate(node_cpu_seconds_total{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Linux memory used",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\"} / node_memory_MemTotal_bytes{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\"})",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Linux filesystem used",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs\"})",
          "legendFormat": "{{host}} {{mountpoint}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Windows CPU used",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(host) (rate(windows_cpu_time_total{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Windows memory used",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - windows_memory_available_bytes{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\"} / windows_memory_physical_total_bytes{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\"})",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 7,
      "title": "Windows filesystem used",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - windows_logical_disk_free_bytes{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\",volume!~\"HarddiskVolume.*\"} / windows_logical_disk_size_bytes{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\",volume!~\"HarddiskVolume.*\"})",
          "legendFormat": "{{host}} {{volume}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Selected host logs",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"homelab\",host=~\"$${host:regex}\",environment=~\"$${environment:regex}\"}",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "loki",
            "uid": "${loki_uid}"
          },
          "maxLines": 200
        }
      ],
      "description": "Only configured bounded log sources. Up to 200 matching lines per query.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "description": "Bounded Linux/Windows collector metrics and selected logs. Presence is scrape health, not proof that every service is healthy. Expected hosts are explicitly declared in Terraform; halted hosts are excluded.",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Inventory host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_uid}"
        },
        "query": "label_values(up{job=\"homelab\"}, host)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "type": "custom",
        "query": "homelab,lab",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
