      }
    },
    {
      "id": 8,
      "title": "Physical network throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_xcp_network_receive_bytes_per_second{host=\"datacenter1\",job=\"homelab_xcp\"}",
          "legendFormat": "RX {{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "homelab_xcp_network_transmit_bytes_per_second{host=\"datacenter1\",job=\"homelab_xcp\"}",
          "legendFormat": "TX {{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "instant": false,
          "range": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "noValue": "No current sample"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "tooltip": {
          "mode": "multi"
        }
      }
    },
