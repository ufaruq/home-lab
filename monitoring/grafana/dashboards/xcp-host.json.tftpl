{
  "uid": "homelab-xcp-host",
  "title": "XCP-ng host \u2014 datacenter1",
  "description": "Agentless datacenter1 hypervisor metrics, managed by Terraform and Ansible.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "homelab",
    "xcp-ng",
    "terraform"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Collector health",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_xcp_collector_success{host=\"datacenter1\",job=\"homelab_xcp\"}",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "A successful current collection is 1. Missing data is not treated as healthy.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No current sample",
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Collection failed",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Source data age",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - homelab_xcp_collector_source_timestamp_seconds{host=\"datacenter1\",job=\"homelab_xcp\"}",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "Above three minutes is stale; during a reboot this may increase or become unavailable.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No current sample",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Host uptime",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_xcp_uptime_seconds{host=\"datacenter1\",job=\"homelab_xcp\"}",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No current sample"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Host RAM (XAPI)",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_xcp_memory_total_bytes{host=\"datacenter1\",job=\"homelab_xcp\"}",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "No current sample"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "CPU used",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_xcp_cpu_used_percent{host=\"datacenter1\",job=\"homelab_xcp\"}",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "instant": false,
          "range": true
        }
      ],
      "description": "Average utilization across host logical CPUs from XAPI RRD; sampled once per minute.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No current sample",
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "RAM used",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * homelab_xcp_memory_used_bytes{host=\"datacenter1\",job=\"homelab_xcp\"} / homelab_xcp_memory_total_bytes{host=\"datacenter1\",job=\"homelab_xcp\"}",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "instant": false,
          "range": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No current sample",
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Host load average",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_xcp_load{host=\"datacenter1\",job=\"homelab_xcp\"}",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "instant": false,
          "range": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No current sample"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
