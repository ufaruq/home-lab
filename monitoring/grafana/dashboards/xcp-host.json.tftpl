      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * homelab_xcp_storage_used_bytes{host=\"datacenter1\",job=\"homelab_xcp\"} / homelab_xcp_storage_total_bytes{host=\"datacenter1\",job=\"homelab_xcp\"}",
          "legendFormat": "{{storage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          },
          "instant": false,
          "range": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
