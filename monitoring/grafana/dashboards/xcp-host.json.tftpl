    {
      "id": 13,
      "title": "Reading this dashboard",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Metrics are collected every minute from the hypervisor through XOA. Check **Collector health** and **Source data age** before interpreting the graphs. Reboots and upgrades can interrupt samples. Unsupported or missing measurements remain empty. Storage legends use stable repository IDs. Notifications are not currently configured."
      }
    }
  ]
}
