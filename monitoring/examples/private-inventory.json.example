{
  "all": {
    "hosts": {
      "oracle_wazuh": {
        "ansible_host": "REPLACE_WITH_VERIFIED_ORACLE_TAILSCALE_ADDRESS",
        "ansible_user": "ubuntu"
      },
      "wazuh": {
        "ansible_host": "REPLACE_WITH_VERIFIED_WAZUH_ADDRESS",
        "ansible_user": "REPLACE_WITH_VERIFIED_SSH_LOGIN"
      },
      "maps": {
        "ansible_host": "REPLACE_WITH_VERIFIED_MAPS_ADDRESS",
        "ansible_user": "REPLACE_WITH_VERIFIED_SSH_LOGIN",
