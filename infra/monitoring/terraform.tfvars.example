# Copy OUTSIDE the checkout to an owner-only JSON/HCL input file.
# The controller expects JSON for --vars. These HCL examples explain every input.
# Trial use is never billed and automatically moves to Free; set the private
# collection flag only after confirming Trial in the stack API.
free_plan_verified          = false
unbilled_trial_collection_verified = false
prometheus_datasource_uid   = "REPLACE_WITH_EXISTING_PROM_UID"
loki_datasource_uid         = "REPLACE_WITH_EXISTING_LOKI_UID"
usage_datasource_uid        = null
enable_security_dashboard  = false

# Select exact inventoried guests after reachability and private settings review.
collector_targets     = []
wazuh_manager_targets = []
opnsense_targets      = []
deployment_reviewed   = false

# Only deployed collectors currently expected online; halted fleet => empty sets.
expected_linux_hosts        = []
expected_windows_hosts      = []
alerts_enabled              = false
existing_contact_point_name = null
