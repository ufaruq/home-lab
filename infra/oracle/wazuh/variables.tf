variable "tenancy_ocid" {
  type = string
  validation {
    condition     = can(regex("^ocid1\\.tenancy\\.", var.tenancy_ocid))
    error_message = "An existing tenancy OCID is required."
  }
}
variable "compartment_ocid" {
  type = string
  validation {
    condition     = can(regex("^ocid1\\.compartment\\.", var.compartment_ocid))
    error_message = "Use the existing home-lab compartment, not the root tenancy."
  }
}
variable "oci_profile" {
  type    = string
  default = "home-lab-bootstrap"
}
variable "availability_domain" {
  type = string
  validation {
    condition     = endswith(var.availability_domain, ":US-SANJOSE-1-AD-1")
    error_message = "Only the verified San Jose home availability domain is allowed."
  }
}
variable "image_ocid" {
  description = "Official pinned Ubuntu 22.04 aarch64 image selected by the read-only audit."
  type        = string
  validation {
    condition     = can(regex("^ocid1\\.image\\.oc1\\.us-sanjose-1\\.", var.image_ocid))
    error_message = "Use the audited home-region platform image."
  }
}
variable "ssh_public_key" {
  description = "Public deployment key only. Never pass a private key."
  type        = string
  validation {
    condition     = can(regex("^ssh-ed25519 [A-Za-z0-9+/=]+( [^\\n]*)?$", trimspace(var.ssh_public_key)))
    error_message = "Provide one public Ed25519 key, not a private key or multiple lines."
  }
}
variable "bootstrap_ssh_cidr" {
  description = "Optional verified public operator IPv4 /32 during bootstrap; null closes public SSH."
  type        = string
  default     = null
  validation {
    condition     = var.bootstrap_ssh_cidr == null ? true : can(cidrnetmask(var.bootstrap_ssh_cidr)) && endswith(var.bootstrap_ssh_cidr, "/32")
    error_message = "Bootstrap SSH permits exactly one IPv4 /32; use null after VPN verification."
  }
}
variable "audit" {
  description = "Fresh read-only CLI audit generated by scripts/oracle/wazuh.py; never fabricate verification flags."
  type = object({
    free_account_verified = bool
    capacity_available    = bool
    existing_storage_gb   = number
    other_a1_cores        = number
    other_a1_memory_gb    = number
    audited_at            = string
  })
  default = {
    free_account_verified = false
    capacity_available    = false
    existing_storage_gb   = 0
    other_a1_cores        = 0
    other_a1_memory_gb    = 0
    audited_at            = "2000-01-01T00:00:00Z"
  }
}

variable "deploy_manager" {
  description = "Run the versioned Wazuh role only after private VPN/SSH access and private role inputs are verified."
  type        = bool
  default     = false
}
